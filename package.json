{
  "name": "openchamber-agents",
  "version": "0.1.6",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Manage global AGENTS.md profiles in OpenChamber: edit, preview changes, activate, back up and restore.",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.4.0"
    },
    "contributes": {
      "panel": {
        "id": "agents-manager",
        "name": "AGENTS.md Manager",
        "icon": "quill-pen",
        "entry": "panel/index.html"
      },
      "statusSection": {
        "entry": "panel/section.html",
        "title": "Global Rules",
        "height": 56
      },
      "filesystem": [
        "~/.config/opencode/AGENTS.md",
        "~/.config/openchamber/agents-manager/**"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "preview": "node scripts/preview.mjs",
    "share": "node scripts/share.mjs"
  },
  "devDependencies": {
    "@openchamber/sdk": "2.0.3",
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "files": [
    "panel/",
    "README.md"
  ]
}
